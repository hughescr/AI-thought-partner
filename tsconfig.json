{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "typeRoots": [
            "./node_modules/@types"
        ],
        "types": [
            "node",
            "bun",
            "jest"
        ],
        "paths": {
            "mistral-tokenizer-ts": [
                "./node_modules/mistral-tokenizer-ts/dist/index.d.ts"
            ],
        }
    },
    "exclude": [
        "node_modules"
    ]
}
